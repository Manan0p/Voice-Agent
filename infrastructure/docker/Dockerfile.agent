# ==============================================================================
# Multi-stage Dockerfile for Voice Agent Runtime & Telephony Streamer
# ==============================================================================
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY pyproject.toml README.md ./

RUN uv venv /app/.venv && uv pip install --no-cache -r pyproject.toml

# ==============================================================================
# Runtime Stage
# ==============================================================================
FROM python:3.12-slim AS runner

WORKDIR /app

# Install audio runtime libraries (libsndfile, ffmpeg)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENVIRONMENT=production

COPY --from=builder /app/.venv /app/.venv
COPY packages ./packages
COPY apps ./apps
COPY voice_agent.py ./

CMD ["python", "voice_agent.py"]
