# ==============================================================================
# PERSONAL AI VOICE & CALL AGENT - PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
APP_NAME="Personal AI Call Agent"
ENVIRONMENT="production"
DEBUG=false
LOG_LEVEL="INFO"

# REST API & Dashboard
API_HOST="0.0.0.0"
API_PORT=8000
NEXT_PUBLIC_API_URL="http://localhost:8000"

# PostgreSQL + pgvector Database
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_this_secure_production_password"
POSTGRES_DB="personal_caller"
DATABASE_URL="postgresql+asyncpg://postgres:change_this_secure_production_password@postgres:5432/personal_caller"

# AI Model Engines (Cloud & Local)
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# Offline Fallback (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
QWEN_MODEL_NAME="qwen2.5:7b-instruct"

# Local STT (faster-whisper)
STT_PROVIDER="whisper"
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="auto"
WHISPER_COMPUTE_TYPE="auto"

# Local TTS (Kokoro-82M)
TTS_PROVIDER="kokoro"
KOKORO_VOICE="af_bella"
KOKORO_SPEED=1.0

# Asterisk PBX & ARI Telephony
ASTERISK_ARI_URL="http://127.0.0.1:8088"
ASTERISK_ARI_USER="asterisk"
ASTERISK_ARI_PASSWORD="change_this_ari_password"
ASTERISK_ARI_APP="voice-agent"

# SIP Trunk & Mobile Call Forwarding
SIP_TRUNK_PROVIDER="direct"
SIP_TRUNK_HOST="sip.yourtrunkprovider.com"
SIP_TRUNK_USERNAME="your_sip_username"
SIP_TRUNK_PASSWORD="your_sip_password"
USER_MOBILE_NUMBER="+15550001122"

# Realtime Telegram Alerts & Human Takeover Bot
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
