# ==============================================================================
# Personal AI Call Agent — Environment Configuration Template
# ==============================================================================

# Server & Application Settings
APP_NAME=personal-ai-caller
VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# Database Settings (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal_caller
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_caller

# LLM Provider Configuration
# Supported: gemini, ollama, mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1024

# Local LLM Fallback (Ollama / Qwen 2.5)
OLLAMA_BASE_URL=http://localhost:11434
QWEN_MODEL_NAME=qwen2.5:7b-instruct

# Speech-to-Text (STT) — faster-whisper
STT_PROVIDER=whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Text-to-Speech (TTS) — Kokoro-82M ONNX
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_bella
KOKORO_SPEED=1.0
KOKORO_MODEL_DIR=models/kokoro

# Realtime Voice & VAD Pipeline Settings
VAD_START_SECS=0.25
VAD_STOP_SECS=1.0
AUDIO_INPUT_SAMPLE_RATE=16000
AUDIO_OUTPUT_SAMPLE_RATE=24000

# Telephony Settings (Twilio Media Streams)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telephony Settings (Asterisk PBX & ARI — Open Source)
ASTERISK_HOST=http://localhost:8088
ASTERISK_ARI_USER=voice_agent
ASTERISK_ARI_PASSWORD=agent_secret_pass
ASTERISK_APP_NAME=voice_agent_app
ASTERISK_SIP_PORT=5060

# External SIP Trunk & DID Settings (e.g. Telnyx, VoIP.ms, Zadarma)
SIP_TRUNK_HOST=trunk.provider.com
SIP_TRUNK_USER=my_sip_user
SIP_TRUNK_PASS=my_sip_pass
DID_NUMBER=+910000000000
OWNER_PHONE_NUMBER=+919876543210

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


