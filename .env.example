# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database Settings (Phases 8-9)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal_caller
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_caller

# AI Models & LLM (Phases 1-4)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OLLAMA_BASE_URL=http://localhost:11434

QWEN_MODEL_NAME=qwen2.5:7b-instruct
# STT (Phase 2)
STT_PROVIDER=whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# TTS (Phase 3)
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_bella
KOKORO_SPEED=1.0
KOKORO_MODEL_DIR=models/kokoro





# Telephony (Phase 11+)
ASTERISK_HOST=localhost
ASTERISK_PORT=5060
ASTERISK_ARI_URL=http://localhost:8088/ari
ASTERISK_ARI_USER=asterisk
ASTERISK_ARI_PASSWORD=asterisk
ASTERISK_WS_URL=ws://localhost:8088/ari/events

# Notifications (Phase 17)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
